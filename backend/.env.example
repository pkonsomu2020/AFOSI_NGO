# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration - Production URLs
FRONTEND_URL=https://afosi.org
ADMIN_URL=https://admin.afosi.org

# Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Admin credentials are stored in Supabase admin_users table

# Email Configuration (Resend — https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=applications@afosi.org
CAREERS_EMAIL=careers@afosi.org
